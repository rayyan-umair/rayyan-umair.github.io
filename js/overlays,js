/* =========================================================
   overlays.js — Overlay management and content rendering
   ========================================================= */

const Overlays = (() => {

  const _overlay  = document.getElementById('overlay');
  const _title    = document.getElementById('overlay-title');
  const _content  = document.getElementById('overlay-content');
  const _closeBtn = document.getElementById('overlay-close');

  const _cache = {};

  const _renderers = {
    profile:        _renderProfile,
    experience:     _renderExperience,
    projects:       _renderProjects,
    certifications: _renderCertifications,
    contact:        _renderContact,
  };

  // ── Fetch / Cache ─────────────────────────────────────────
  async function _fetchData(id) {
    if (_cache[id]) return _cache[id];
    try {
      const res  = await fetch(`data/${id}.json`);
      const data = await res.json();
      _cache[id] = data;
      return data;
    } catch (err) {
      console.error(`[Overlays] Failed to load data/${id}.json`, err);
      return null;
    }
  }

  // ── Open / Close ──────────────────────────────────────────
  async function open(id) {
    const label  = CONFIG.nodes.find(n => n.id === id)?.label || id.toUpperCase();
    _title.textContent  = label;
    _content.innerHTML  = '<div style="color:var(--clr-emerald-d);font-size:12px;letter-spacing:2px;">LOADING...</div>';
    _overlay.classList.remove('hidden');
    document.body.style.overflow = 'hidden';

    const data = await _fetchData(id);
    if (!data) {
      _content.innerHTML = '<div style="color:rgba(255,100,100,0.7);font-size:12px;">FAILED TO LOAD MODULE DATA</div>';
      return;
    }

    const renderer = _renderers[id];
    if (renderer) {
      _content.innerHTML = renderer(data);
    } else {
      _content.innerHTML = `<pre style="font-size:12px;color:var(--clr-white)">${JSON.stringify(data, null, 2)}</pre>`;
    }
  }

  function close() {
    _overlay.classList.add('hidden');
    document.body.style.overflow = '';
  }

  // ── Event Listeners ───────────────────────────────────────
  _closeBtn.addEventListener('click', close);
  _overlay.querySelector('.overlay-bg').addEventListener('click', close);
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && !_overlay.classList.contains('hidden')) close();
  });

  // ── Renderers ─────────────────────────────────────────────
  function _renderProfile(d) {
    const skills = (d.skills || []).map(s => `
      <div class="skill-row">
        <div class="skill-name">
          <span>${s.name}</span>
          <span>${s.level}%</span>
        </div>
        <div class="skill-bar-track">
          <div class="skill-bar-fill" style="width:${s.level}%"></div>
        </div>
      </div>`).join('');

    const grid = (d.info || []).map(i => `
      <div class="info-block">
        <div class="label">${i.label}</div>
        <div class="value">${i.value}</div>
      </div>`).join('');

    return `
      <div class="section-label">// IDENTITY</div>
      <p class="summary-text">${d.summary || ''}</p>
      <div class="profile-grid">${grid}</div>
      <div class="section-label" style="margin-top:24px">// CORE COMPETENCIES</div>
      ${skills}
    `;
  }

  function _renderExperience(d) {
    const items = (d.experience || []).map(e => `
      <div class="exp-item">
        <div class="exp-role">${e.role}</div>
        <div class="exp-company">${e.company}</div>
        <div class="exp-date">${e.date}</div>
        <div class="exp-desc">${e.description}</div>
      </div>`).join('');
    return `<div class="section-label">// WORK HISTORY</div>${items}`;
  }

  function _renderProjects(d) {
    const items = (d.projects || []).map(p => {
      const tags = (p.tech || []).map(t => `<span class="tech-tag">${t}</span>`).join('');
      return `
        <div class="project-card">
          <div class="project-name">${p.name}</div>
          <div class="project-tech">${tags}</div>
          <div class="project-desc">${p.description}</div>
        </div>`;
    }).join('');
    return `<div class="section-label">// ACTIVE PROJECTS</div>${items}`;
  }

  function _renderCertifications(d) {
    const items = (d.certifications || []).map(c => `
      <div class="cert-item">
        <div class="cert-icon">${c.icon || '🛡️'}</div>
        <div>
          <div class="cert-name">${c.name}</div>
          <div class="cert-issuer">${c.issuer}</div>
          <div class="cert-date">${c.date}</div>
        </div>
      </div>`).join('');
    return `<div class="section-label">// CREDENTIALS</div>${items}`;
  }

  function _renderContact(d) {
    const items = (d.links || []).map(l => `
      <a class="contact-link" href="${l.url}" target="_blank" rel="noopener">
        <div class="contact-icon">${l.icon}</div>
        <div>
          <div class="contact-label">${l.label}</div>
          <div class="contact-value">${l.value}</div>
        </div>
        <div class="contact-arrow">→</div>
      </a>`).join('');
    const note = d.note ? `<p class="summary-text" style="margin-top:16px;font-size:12px;">${d.note}</p>` : '';
    return `<div class="section-label">// COMMUNICATIONS</div>${items}${note}`;
  }

  return { open, close };

})();
